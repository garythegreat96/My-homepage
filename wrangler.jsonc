{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-homepage",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
